# One ephemeral GitHub Actions runner per instance: github-runner@1,
# github-runner@2, ... Each instance is a `docker run --rm` of the runner
# image registered with --ephemeral, so the runner takes exactly one job,
# deregisters, exits, and the container is deleted with everything a job
# wrote to it. systemd then starts a fresh one. Nothing survives from one
# job to the next: no work directory, no tool cache, no half-written
# download, and nothing a pull request planted.
#
# Install on the CI VM (not on the household host):
#   sudo install -m 0644 github-runner@.service /etc/systemd/system/
#   sudo install -m 0600 ci-runner.env /etc/wildstone/ci-runner.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now github-runner@1 github-runner@2
# See README.md alongside this file.

[Unit]
Description=Ephemeral GitHub Actions runner %i (wildstone-homelab)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Never treat a fast job loop as a failure.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/wildstone/ci-runner.env
# The image must be pinned by digest. It receives the registration token
# and the Docker socket, so a mutable tag would hand the CI machine to
# whoever controls the tag. Refuse to start otherwise.
ExecStartPre=/bin/sh -c 'case "$RUNNER_IMAGE" in *@sha256:*) ;; *) echo "RUNNER_IMAGE must be pinned by digest (image@sha256:...), got: $RUNNER_IMAGE" >&2; exit 1;; esac'
ExecStartPre=/usr/bin/docker pull ${RUNNER_IMAGE}
ExecStartPre=-/usr/bin/docker rm -f gh-runner-%i
# The job's work directory lives on the host and is bound into the
# container AT THE SAME PATH. ci.yml runs shellcheck as
# `docker run -v "$PWD:/mnt"`, and Docker resolves that bind source on
# the daemon's host, not inside the runner container: a checkout that
# exists only inside the container is invisible to it. Same path on both
# sides makes $PWD mean the same thing to both. It is wiped before every
# container and after, so it is as ephemeral as the container.
ExecStartPre=/bin/rm -rf /srv/ci-work/%i
ExecStartPre=/bin/mkdir -p /srv/ci-work/%i
# --rm: the container is deleted when the runner exits after its one job.
# The Docker socket is mounted because ci.yml runs shellcheck through
# `docker run`; a job can therefore do anything Docker on this machine
# can, which is why the machine is the isolation boundary, not the
# container.
ExecStart=/usr/bin/docker run --rm --name gh-runner-%i \
  --env-file /etc/wildstone/ci-runner.env \
  -e RUNNER_NAME=%H-%i \
  -e EPHEMERAL=1 \
  -e DISABLE_AUTO_UPDATE=1 \
  -e RUNNER_WORKDIR=/srv/ci-work/%i \
  -v /srv/ci-work/%i:/srv/ci-work/%i \
  -v /var/run/docker.sock:/var/run/docker.sock \
  ${RUNNER_IMAGE}
ExecStop=-/usr/bin/docker stop gh-runner-%i
ExecStopPost=/bin/rm -rf /srv/ci-work/%i
# A clean exit is the normal end of every job; restart unconditionally.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
