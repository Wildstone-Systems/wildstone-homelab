{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "secret scan (gitleaks)", "integration_id": 15368 },
          { "context": "shell scripts (ADR-W014/W018)", "integration_id": 15368 },
          { "context": "console (typecheck + build + checks, ADR-W016/W027)", "integration_id": 15368 },
          { "context": "bounded DDGS worker (ADR-W047, S18)", "integration_id": 15368 },
          { "context": "native agent runtime (OpenAI Agents SDK sidecar, #357)", "integration_id": 15368 },
          { "context": "go (amd64)", "integration_id": 15368 },
          { "context": "go (arm64)", "integration_id": 15368 }
        ]
      }
    }
  ],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" }
  ]
}
