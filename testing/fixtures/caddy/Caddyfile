{
	auto_https off
}

# Public domain via Cloudflare Tunnel - FIXED
http://home.example.com {
	forward_auth 192.0.2.71:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}

	# === HOMEPAGE API (specific paths first) ===
	handle /api/services {
		reverse_proxy family-homepage:3000
	}
	handle /api/bookmarks {
		reverse_proxy family-homepage:3000
	}
	handle /api/widgets {
		reverse_proxy family-homepage:3000
	}
	handle /api/hash {
		reverse_proxy family-homepage:3000
	}
	handle /api/config/custom.css {
		reverse_proxy family-homepage:3000
	}
	handle /api/config/custom.js {
		reverse_proxy family-homepage:3000
	}
	handle /api/validate {
		reverse_proxy family-homepage:3000
	}
	handle /_next/* {
		reverse_proxy family-homepage:3000
	}

	# === NAVIDROME ===
	redir /music /music/app 301
	handle_path /music/* {
		reverse_proxy 192.0.2.56:4533
	}

	# === JELLYFIN ===
	redir /jellyfin /jellyfin/web/ 301
	handle_path /jellyfin/* {
		reverse_proxy 192.0.2.56:8096
	}

	# === IMMICH (absolute path assets) ===
	handle /_app/* {
		reverse_proxy 192.0.2.56:2283
	}
	handle /api/* {
		reverse_proxy 192.0.2.56:2283
	}
	handle /favicon.ico {
		reverse_proxy 192.0.2.56:2283
	}
	handle /favicon-*.png {
		reverse_proxy 192.0.2.56:2283
	}
	handle /apple-touch-icon.png {
		reverse_proxy 192.0.2.56:2283
	}
	handle /manifest.json {
		reverse_proxy 192.0.2.56:2283
	}

	# Immich root entry
	redir /photos /photos/ 301
	handle_path /photos/* {
		reverse_proxy 192.0.2.56:2283
	}

	# Catch-all for homepage
	handle {
		reverse_proxy family-homepage:3000
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
	}
}

# Preferred Tailscale private routes
auth.tailnet {
	tls internal
	reverse_proxy 192.0.2.71:9091
}

code.tailnet {
	tls internal
	forward_auth 192.0.2.71:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy code-server:8080
}

