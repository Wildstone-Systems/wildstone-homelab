{
  "name": "wildstone-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "ui-check": "node scripts/ui-check.mjs",
    "render-check": "esbuild scripts/render-check.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/render-check.cjs --jsx=automatic && node node_modules/.cache/render-check.cjs",
    "contrast-check": "node scripts/contrast-check.mjs",
    "handoff-check": "node scripts/handoff-check.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
