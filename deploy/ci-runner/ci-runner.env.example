# Copy to /etc/wildstone/ci-runner.env, mode 0600, root-owned.
# Read by run-one-job.sh on the host. Nothing in this file is passed to
# the runner container.

# The official GitHub Actions runner image, PINNED BY DIGEST. The script
# refuses anything else: this container receives the host's Docker
# socket, so a mutable tag would let whoever controls the tag control the
# CI machine. This digest is actions-runner 2.330.0 (multi-arch index) as
# reviewed on 2026-09-26. To move to a newer release, resolve the new
# digest yourself and review the change:
#   docker pull ghcr.io/actions/actions-runner:<version>
#   docker inspect --format '{{index .RepoDigests 0}}' ghcr.io/actions/actions-runner:<version>
RUNNER_IMAGE=ghcr.io/actions/actions-runner@sha256:ee54ad8776606f29434f159196529b7b9c83c0cb9195c1ff5a7817e7e570dcfe

# The repository the runners register against.
GITHUB_REPO=chickenrat17/wildstone-homelab

# A fine-grained personal access token used ONLY on the host, to mint a
# single-use just-in-time runner credential before each job. Create it
# at github.com/settings/personal-access-tokens with:
#   Repository access: only wildstone-homelab
#   Repository permissions: Administration -> Read and write
# Nothing else. Rotate it like any other credential; it lives nowhere
# except this file on the CI machine, and never enters a container.
ACCESS_TOKEN=REPLACE-WITH-FINE-GRAINED-PAT

# Must match runs-on in .github/workflows/ci.yml and release.yml.
LABELS=self-hosted,dev-services
RUNNER_NAME_PREFIX=ci-vm
# The repository's runner group; 1 is "Default".
RUNNER_GROUP_ID=1
