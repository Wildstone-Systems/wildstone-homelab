# Managed by Wildstone. Pod Security levels (W050 plan §6.5): apps are held
# to restricted; host-bound work (devices, host networking) gets its own
# namespace so the exception is visible and narrow.
apiVersion: v1
kind: Namespace
metadata:
  name: wildstone-system
  labels:
    pod-security.kubernetes.io/enforce: baseline
---
apiVersion: v1
kind: Namespace
metadata:
  name: wildstone-apps
  labels:
    pod-security.kubernetes.io/enforce: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: wildstone-host
  labels:
    pod-security.kubernetes.io/enforce: privileged
---
# Longhorn's manager, CSI plugin and instance managers mount host disks and
# run privileged; its namespace says so. The vendored Longhorn manifest
# also declares this namespace, without labels, under its own field
# manager, so these labels stay.
apiVersion: v1
kind: Namespace
metadata:
  name: longhorn-system
  labels:
    pod-security.kubernetes.io/enforce: privileged
