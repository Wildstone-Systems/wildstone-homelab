}

aio-stage.tailnet {
	tls internal
	@aio_public_api path /api/v1/auth/* /api/v1/health
	handle @aio_public_api {
		reverse_proxy 192.0.2.53:8000
	}
	forward_auth 192.0.2.71:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	@api path /api/v1/*
	handle @api {
		reverse_proxy 192.0.2.53:8000
	}
	handle {
		reverse_proxy 192.0.2.53:5173
	}
}

