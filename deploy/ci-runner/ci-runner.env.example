# Copy to /etc/wildstone/ci-runner.env, mode 0600, root-owned.
# Read by both systemd (RUNNER_IMAGE) and the runner container (the rest).

# Runner image. myoung34/github-runner wraps the official actions/runner
# with registration, ephemeral mode and re-registration handled. Pin to a
# digest once you have run it once and are happy:
#   RUNNER_IMAGE=myoung34/github-runner@sha256:...
RUNNER_IMAGE=myoung34/github-runner:ubuntu-noble

# Register against this repository only.
RUNNER_SCOPE=repo
REPO_URL=https://github.com/chickenrat17/wildstone-homelab

# A fine-grained personal access token used ONLY to mint a fresh
# one-hour registration token before each job. Create it at
# github.com/settings/personal-access-tokens with:
#   Repository access: only wildstone-homelab
#   Repository permissions: Administration -> Read and write
# Nothing else. Rotate it like any other credential; it lives nowhere
# except this file on the CI VM.
ACCESS_TOKEN=REPLACE-WITH-FINE-GRAINED-PAT

# Must match runs-on in .github/workflows/ci.yml and release.yml.
LABELS=self-hosted,dev-services
RUNNER_NAME_PREFIX=ci-vm
# Work directory inside the container; discarded with the container.
RUNNER_WORKDIR=/_work
